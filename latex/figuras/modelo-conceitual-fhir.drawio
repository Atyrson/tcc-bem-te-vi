  <diagram id="modelo-conceitual" name="Modelo conceitual">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="583" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Entidades -->
        <mxCell id="pac" value="&lt;b&gt;Paciente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CPF ou CNS, nome, sexo,&lt;br&gt;data de nascimento&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Patient (BR-Core)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
